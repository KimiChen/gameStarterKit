{
  "version": 1,
  "purpose": "核心能力、默认入口、真源、运行时边界、验证命令和权威文档的可检查清单",
  "capabilities": [
    {
      "id": "shared-contract",
      "category": "core",
      "defaultEntry": "apps/shared/src/index.ts",
      "sourceOfTruth": "apps/shared/src",
      "wireBoundary": "apps/shared/src/protocol",
      "verification": [{ "kind": "root", "script": "typecheck" }, { "kind": "root", "script": "verify:sync" }],
      "docs": ["docs/OVERVIEW.md", "AGENTS.md"]
    },
    {
      "id": "client-session-and-navigation",
      "category": "core",
      "defaultEntry": "apps/client/src/Main.ts",
      "sourceOfTruth": "apps/client/src/net/session.ts",
      "wireBoundary": "apps/client/src/net",
      "verification": [{ "kind": "root", "script": "test:client" }],
      "docs": ["plan-v4.md", "docs/CLIENT.md"]
    },
    {
      "id": "game-room-runtime",
      "category": "core",
      "defaultEntry": "apps/server/src/rooms/GameRoom.ts",
      "sourceOfTruth": "apps/server/src/rooms/GameRoom.ts",
      "wireBoundary": "apps/shared/src/protocol/rooms.ts",
      "verification": [{ "kind": "workspace", "workspace": "@game/server", "script": "test" }],
      "docs": ["plan-v4.md", "docs/SERVER.md"]
    },
    {
      "id": "asset-effect-and-zone-isolation",
      "category": "core",
      "defaultEntry": "apps/server/src/websocket/shop/purchase.ts",
      "sourceOfTruth": "apps/server/src/core/infra/redisScripts.ts",
      "wireBoundary": "apps/shared/src/protocol/lobbyRpc/economy.ts",
      "verification": [{ "kind": "workspace", "workspace": "@game/server", "script": "test:int" }],
      "docs": ["plan-v4.md", "docs/SERVER.md", "docs/DUAL_MODE.md"]
    },
    {
      "id": "outbox-relayer",
      "category": "extra",
      "defaultEntry": "apps/server/src/core/economy/relayer.ts",
      "sourceOfTruth": "apps/server/src/core/economy/relayer.ts",
      "wireBoundary": "apps/server/src/core/economy/outbox.ts",
      "launch": { "kind": "workspace", "workspace": "@game/server", "script": "relayer" },
      "verification": [{ "kind": "workspace", "workspace": "@game/server", "script": "test:int" }],
      "docs": ["docs/EXTRAFEATURES.md", "docs/SERVER.md"]
    },
    {
      "id": "character-ready",
      "category": "core",
      "defaultEntry": "apps/server/src/websocket/LobbyRoom.ts",
      "sourceOfTruth": "apps/server/src/player/character.ts",
      "wireBoundary": "apps/shared/src/protocol/lobbyRpc/user.ts",
      "verification": [{ "kind": "workspace", "workspace": "@game/server", "script": "test:int" }],
      "docs": ["plan-v4.md", "docs/SERVER.md"]
    },
    {
      "id": "process-lifecycle",
      "category": "core",
      "defaultEntry": "apps/server/src/index.ts",
      "sourceOfTruth": "apps/server/src/core/infra/lifecycle.ts",
      "wireBoundary": "apps/server/src/index.ts",
      "verification": [{ "kind": "workspace", "workspace": "@game/server", "script": "test" }],
      "docs": ["plan-v4.md", "docs/SERVER.md"]
    },
    {
      "id": "gameplay-boundary",
      "category": "core",
      "defaultEntry": "apps/client/src/gameplay/catalog.ts",
      "sourceOfTruth": "apps/client/src/logic/gameplay",
      "wireBoundary": "apps/client/src/net/RoomClient.ts",
      "verification": [{ "kind": "root", "script": "test:client" }],
      "docs": ["plan-v4.md", "docs/CLIENT.md"]
    },
    {
      "id": "view-logic-lifecycle",
      "category": "core",
      "defaultEntry": "apps/client/src/view/ViewMgr.ts",
      "sourceOfTruth": "apps/client/src/view",
      "wireBoundary": "apps/client/src/view/pages.ts",
      "verification": [{ "kind": "root", "script": "test:fgui" }, { "kind": "root", "script": "typecheck:client" }],
      "docs": ["plan-v4.md", "docs/CLIENT.md"]
    },
    {
      "id": "wire-runtime-contract",
      "category": "core",
      "defaultEntry": "apps/client/src/net/WebSocketClient.ts",
      "sourceOfTruth": "apps/shared/src/protocol",
      "wireBoundary": "apps/shared/src/protocol/http.ts",
      "verification": [{ "kind": "root", "script": "test:client" }, { "kind": "workspace", "workspace": "@game/server", "script": "test" }],
      "docs": ["plan-v4.md", "docs/SERVER.md", "docs/CLIENT.md"]
    },
    {
      "id": "fgui-resource-contract",
      "category": "core",
      "defaultEntry": "tools/fgui-codegen/cli.ts",
      "sourceOfTruth": "apps/art/fairygui",
      "wireBoundary": "apps/client/src/view",
      "verification": [{ "kind": "root", "script": "test:fgui" }, { "kind": "root", "script": "verify:fgui" }],
      "docs": ["plan-v4.md", "tools/fgui-codegen/README.md", "apps/art/fairygui/README.md"]
    },
    {
      "id": "server-infrastructure-boundaries",
      "category": "core",
      "defaultEntry": "apps/server/src/core/infra/config.ts",
      "sourceOfTruth": "apps/server/src/core/infra",
      "wireBoundary": "apps/server/src/core/infra/redisRoute.ts",
      "verification": [{ "kind": "workspace", "workspace": "@game/server", "script": "test" }, { "kind": "workspace", "workspace": "@game/server", "script": "smoke:framework" }],
      "docs": ["plan-v4.md", "docs/SERVER.md"]
    },
    {
      "id": "area-directory-determinism",
      "category": "core",
      "defaultEntry": "apps/client/src/net/serverSession.ts",
      "sourceOfTruth": "apps/client/src/net/serverSession.ts",
      "wireBoundary": "apps/shared/src/protocol/http.ts",
      "verification": [{ "kind": "root", "script": "test:client" }],
      "docs": ["plan-v4.md", "docs/CLIENT.md", "docs/WEBPLATFORM.md"]
    },
    {
      "id": "verification-and-locks",
      "category": "core",
      "defaultEntry": "scripts/verify-ecs.mjs",
      "sourceOfTruth": "scripts",
      "wireBoundary": "scripts/protocol.fingerprint",
      "verification": [{
        "kind": "root",
        "script": "verify:core",
        "requires": [
          { "kind": "root", "script": "verify:vendor" },
          { "kind": "root", "script": "verify:inventory" },
          { "kind": "root", "script": "test:inventory" },
          { "kind": "root", "script": "test:client" }
        ]
      }],
      "docs": ["plan-v4.md", "README.md"]
    }
  ],
  "defaultModules": [
    {
      "entry": "apps/server/src/index.ts",
      "capabilities": ["process-lifecycle", "game-room-runtime", "asset-effect-and-zone-isolation", "character-ready", "server-infrastructure-boundaries"],
      "docs": ["docs/SERVER.md", "docs/OVERVIEW.md"]
    },
    {
      "entry": "apps/server/src/app.config.ts",
      "capabilities": ["game-room-runtime", "character-ready", "wire-runtime-contract", "server-infrastructure-boundaries"],
      "docs": ["docs/SERVER.md", "docs/OVERVIEW.md"]
    },
    {
      "entry": "apps/client/src/Main.ts",
      "capabilities": ["client-session-and-navigation", "gameplay-boundary", "view-logic-lifecycle", "wire-runtime-contract", "area-directory-determinism"],
      "docs": ["docs/CLIENT.md", "docs/OVERVIEW.md"]
    },
    {
      "entry": "apps/shared/src/index.ts",
      "capabilities": ["shared-contract"],
      "docs": ["docs/OVERVIEW.md"]
    },
    {
      "entry": "apps/Cocos/assets/scene.scene",
      "capabilities": ["client-session-and-navigation", "gameplay-boundary"],
      "docs": ["docs/CLIENT.md"]
    }
  ],
  "defaultScene": "apps/Cocos/assets/scene.scene",
  "routeOfTruth": {
    "corePlan": "plan-v4.md",
    "extraCapabilities": "docs/EXTRAFEATURES.md"
  },
  "referenceDocs": ["plan.md", "plan-v2.md", "plan-v3.md", "todo-godogen.md", "docs/Non-intrusive.md"],
  "workspaceCommandScope": [
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "dev" },
      "supersededBy": { "kind": "root", "script": "dev" },
      "reason": "根 dev 直接转调该脚本，助手命令表登记根入口即可"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "start" },
      "supersededBy": { "kind": "root", "script": "start:server" },
      "reason": "根 start:server 直接转调该脚本，助手命令表登记根入口即可"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "typecheck" },
      "supersededBy": { "kind": "root", "script": "typecheck" },
      "reason": "根 typecheck 聚合调用，单独登记会与聚合入口重复"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/shared", "script": "typecheck" },
      "supersededBy": { "kind": "root", "script": "typecheck" },
      "reason": "根 typecheck 聚合调用，单独登记会与聚合入口重复"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "stack:stop" },
      "documentedIn": "docs/SERVER.md",
      "reason": "stack 的配对停止命令，随本地依赖栈说明一并登记"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "relayer" },
      "documentedIn": "docs/EXTRAFEATURES.md",
      "reason": "常驻 outbox relayer 进程，不随 dev 启动，属额外功能边界"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "freeze-worker" },
      "documentedIn": "docs/EXTRAFEATURES.md",
      "reason": "默认关闭的归档 worker，属额外功能边界"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "settle" },
      "documentedIn": "docs/EXTRAFEATURES.md",
      "reason": "常驻结算 consumer 进程，不随 dev 启动，属额外功能边界"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "codegen:http" },
      "documentedIn": "docs/SERVER.md",
      "reason": "生成物刷新命令，登记在 HTTP endpoint 章节而非日常命令表"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "codegen:state" },
      "documentedIn": "docs/OVERVIEW.md",
      "reason": "生成物刷新命令，登记在标准开发动线而非日常命令表"
    },
    {
      "command": { "kind": "workspace", "workspace": "@game/server", "script": "loadtest" },
      "documentedIn": "docs/EXTRAFEATURES.md",
      "reason": "当前入房参数已失效，登记为不可用工具而非开发动线命令"
    }
  ]
}

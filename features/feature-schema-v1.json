{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "feature.json v1（Non-intrusive §5.1/§7.1：跨层登记信息，禁业务逻辑/可执行回调；menu 只声明入口身份，⛔ 无 slot/order——位置归宿主 features/host.json，docs/PLUGIN.md §6）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "viewDirs", "views", "owners", "routes", "menu"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
    "category": { "type": "string", "pattern": "^(core|extra)$" },
    "docs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*\\.md$" }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "defaultEntry", "sourceOfTruth", "wireBoundary", "verification", "docs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "category": { "type": "string", "pattern": "^(core|extra)$" },
          "defaultEntry": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*$" },
          "sourceOfTruth": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*$" },
          "wireBoundary": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*$" },
          "verification": { "type": "array", "items": { "type": "object" } },
          "docs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*\\.md$" } },
          "launch": { "type": "object" }
        }
      }
    },
    "resident": { "type": "boolean" },
    "module": { "type": "string", "pattern": "^apps/client/src/features/[a-z][A-Za-z0-9]{0,63}/index\\.ts$" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
    },
    "viewDirs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^apps/client/src/[A-Za-z0-9_/.-]+$" }
    },
    "views": {
      "type": "array",
      "items": { "type": "string", "pattern": "^apps/client/src/[A-Za-z0-9_/.-]+View\\.view\\.json$" }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "logicDir"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          "logicDir": { "type": "string", "pattern": "^apps/client/src/(logic|features)/[A-Za-z0-9_/.-]+$" }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "view"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          "view": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$" }
        }
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "label", "labelKey", "launch"],
        "properties": {
          "entryId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          "label": { "type": "string", "pattern": "^.{1,64}$" },
          "labelKey": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.]{0,127}$" },
          "icon": { "type": "string", "pattern": "^ui://[A-Za-z0-9_]+/[A-Za-z0-9_.-]+$" },
          "launch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "pattern": "^(gameplay|route)$" },
              "gameplayId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
              "routeId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
            }
          }
        }
      }
    }
  }
}

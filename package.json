{
  "name": "@game/gameStarterKit",
  "version": "0.1.0",
  "private": true,
  "description": "游戏开发期 monorepo：Cocos Creator 3.8.8 客户端 + Colyseus 0.17 服务端 + 双端共享包",
  "workspaces": [
    "apps/shared",
    "apps/server"
  ],
  "scripts": {
    "sync:webplatform-contract": "node scripts/sync-webplatform-contract.mjs && npm run sync:shared",
    "verify:webplatform-contract": "node scripts/sync-webplatform-contract.mjs --check",
    "sync:shared": "node scripts/sync-shared.mjs && node scripts/sync-client.mjs",
    "sync:client": "node scripts/sync-client.mjs",
    "sync:client:watch": "node scripts/sync-client.mjs --watch",
    "codegen:fgui": "node --import tsx tools/fgui-codegen/cli.ts",
    "init:project": "node scripts/init-project.mjs",
    "perf:client": "node --import tsx tools/client-perf-baseline.ts",
    "verify:perf": "node scripts/verify-perf-baseline.mjs",
    "sync:shared:watch": "node scripts/sync-shared.mjs --watch",
    "dev:client": "node scripts/dev-client.mjs",
    "dev": "npm --workspace @game/server run dev",
    "start:server": "npm --workspace @game/server run start",
    "typecheck": "npm run verify:webplatform-contract && npm --workspace @game/shared run typecheck && npm --workspace @game/server run typecheck && npm run typecheck:client && npm run typecheck:client:legacy && npm run verify:sync",
    "verify:sync": "node scripts/sync-shared.mjs --check && node scripts/sync-client.mjs --check",
    "verify:project": "node scripts/verify-project-metadata.mjs",
    "verify:ecs": "node scripts/verify-ecs.mjs",
    "verify:vendor": "node scripts/vendor-lock.mjs --check",
    "verify:fgui": "node scripts/fgui-manifest.mjs --check",
    "verify:inventory": "node scripts/verify-inventory.mjs",
    "fetch:fgui": "node scripts/fetch-fgui.mjs",
    "fetch:colyseus": "node scripts/fetch-colyseus.mjs",
    "config:excel-to-json": "node tools/excel-to-json.mjs",
    "config:excel-to-json:check": "node tools/excel-to-json.mjs --check",
    "typecheck:client": "tsc -p apps/client/tsconfig.test.json --noEmit",
    "typecheck:client:legacy": "tsc -p apps/client/tsconfig.json --noEmit",
    "test:client": "cd apps/server && node --import tsx --test ../client/test/*.test.ts ../../scripts/vendor-lock.test.mjs",
    "test:vendor": "node --test scripts/vendor-lock.test.mjs",
    "test:fgui": "cd apps/server && node --import tsx --test ../../tools/fgui-codegen/fgui-codegen.test.ts ../client/test/fguiContract.test.ts ../client/test/viewRegistry.test.ts",
    "test:faults": "node scripts/fault-matrix.mjs",
    "test:faults:int": "node scripts/fault-matrix.mjs --integration",
    "verify:core": "npm run verify:project && npm run typecheck && npm run verify:ecs && npm run verify:vendor && npm run verify:fgui && npm run verify:inventory && npm run verify:perf && npm run test:client",
    "verify:all": "npm run verify:core && npm run test:client && npm --workspace @game/server run test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@gono/webplatform-contract": "file:vendor/gono-webplatform-contract-1.0.0.tgz",
    "@types/node": "^22.13.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  }
}

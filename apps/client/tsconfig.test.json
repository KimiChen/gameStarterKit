{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    // AUTO binding fields are protected by codegen; retain the strict unused
    // declaration check for business code as well as the structural contract.
    "noUnusedLocals": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": false
  },
  "include": [
    "client-test-stubs.d.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "../../tools/fgui-codegen/**/*.ts"
  ],
  "exclude": ["**/*.meta", "temp/**"]
}

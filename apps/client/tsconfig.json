{
  // 严格性开关走单源；本文件的 target/lib/cc 桩等客户端特有项不受影响。
  "extends": "../../tsconfig.strict.json",

  // Creator 兼容 legacy 配置（不 extends Creator 生成的 temp/，可离线检查全部客户端源码）。
  // 完整 Node/CI strict 探针使用同目录的 tsconfig.test.json 与 client-test-stubs.d.ts；
  // 跑法：npm run typecheck:client:legacy（根 package.json）；根 typecheck 会自动串行调用它。
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    // FGUI AUTO fields are protected by codegen, so the legacy probe can keep
    // the shared strict noUnusedLocals contract for all source code.
    "noUnusedLocals": true,
    // 钉 ES2017（铁律 4：客户端下限）——⛔ 不放宽到 ES2020：无头 CI 会放行 Creator 侧标红、
    // 老 JSCore 运行时才崩的 API（Object.fromEntries / Promise.allSettled / matchAll…）
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2017", "DOM"],
    "types": [],
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": false,
    "baseUrl": ".",
    "paths": {}
  },
  "include": [
    "cc-stub.d.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.meta"
  ]
}

<% if (property.annotation) { %>
    /**<% property.annotation.forEach(annotation => { %>
     * <%- annotation -%><% }) %>
     */<% } %>
    <%- property.visibility %> <% if (property.readonly) { %> readonly <% } %> <%- property.name %>:<%- property.type %> <% if (property.value!== undefined) { %> = <%- property.value %> <% } %>
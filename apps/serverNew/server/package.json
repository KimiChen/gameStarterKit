{
    "name": "game-service",
    "version": "1.0.0",
    "private": true,
    "license": "ISC",
    "type": "commonjs",
    "scripts": {
        "AdjustGen:生成adjust自定义功能的结构": "ts-node ./scripts/generator/adjust/AdjustDocumentGenerator.ts",
        "ClassList:列出activityOperator导出类": "ts-node ./scripts/generator/classList/ClassListGen.ts -s ../../../src/modules/activity -o activityOperator-info.ts -b ActivityOperator",
        "ClassList:列出gmApi导出类": "ts-node ./scripts/generator/classList/ClassListGen.ts -s ../../../src -o gm-info.ts -b GmAction -r ^Action",
        "DbBean:通过mysql结构生成dbBean": "ts-node --project scripts/generator/tsconfig.record-refresh.json ./scripts/generator/db/GenerateEntities.ts bearjoy release",
        "benchmark:multiprocess": "node scripts/benchmark/multiprocess.cjs",
        "build": "sh ./scripts/build/package-release.sh all",
        "build:runtime": "node scripts/build/build-alloy-core-runtime.mjs development",
        "check": "pnpm check:generated && pnpm check:quick && pnpm check:engine-contracts",
        "check:engine-contracts": "pnpm -C ../engine test:contracts",
        "check:generated": "node scripts/generator/check-generated.js",
        "check:kit-protocol": "node --import tsx ../../../tools/lobby-protocol/cli.ts --check",
        "check:lobby-contract": "node scripts/protocol/compile-shared-contract.cjs --check",
        "check:quick": "pnpm check:static && pnpm test:suite -- startup structure --skip-bean-validation",
        "check:static": "pnpm typecheck && pnpm lint:baseline && pnpm format:check",
        "dev": "pnpm build:runtime && node deploy/dev/entrypoint.cjs -p bearjoy -v dev --sid 1",
        "dev:http": "ts-node --files src/http/main.ts -p bearjoy -v dev -ap 25001",
        "error-codes:to-excel": "ts-node --project scripts/tsconfig.json scripts/errorcode/toExcel.ts",
        "format": "prettier --write \"./**/*.{html,ts,js,cjs,json,md}\"",
        "format:check": "prettier --check \"./**/*.{html,ts,js,cjs,json,md}\"",
        "gen:error-codes": "ts-node --project scripts/tsconfig.json scripts/errorcode/genFromConf.ts",
        "gen:kit-protocol": "node --import tsx ../../../tools/lobby-protocol/cli.ts",
        "gen:lobby-contract": "node scripts/protocol/compile-shared-contract.cjs",
        "gen:modules": "ts-node --project scripts/tsconfig.json scripts/modules/GenerateModuleRegistry.ts",
        "gen:modules:check": "ts-node --project scripts/tsconfig.json scripts/modules/GenerateModuleRegistry.ts --check",
        "genTa:生成数数结构与函数": "ts-node ./scripts/taToModel/main.ts",
        "generate": "pnpm gen:lobby-contract && ts-node --project scripts/generator/tsconfig.record-refresh.json ./scripts/generator/differ/AutoGen.ts && pnpm gen:modules && pnpm gen:error-codes",
        "http.js测试": "node dist/http/index.js -p bearjoy -v dev -ap 25001",
        "kit": "node scripts/kit/kit.cjs",
        "lint": "eslint src",
        "lint:baseline": "node scripts/lint/check-lint.js",
        "lint:baseline:update": "node scripts/lint/check-lint.js --update",
        "lint:fix": "eslint src --fix",
        "migration:新建一个迁移文件": "npx mysql-tool migration:create",
        "migration:通过配置生成Mysql结构,拉代码后操作": "npx mysql-tool migration:run bearjoy release",
        "module:show": "ts-node --transpile-only --project scripts/generator/tsconfig.record-refresh.json scripts/modules/ListModules.ts --module",
        "modules:add": "ts-node --project scripts/tsconfig.json scripts/modules/ModuleLibraryCommand.ts add",
        "modules:archive": "ts-node --project scripts/tsconfig.json scripts/modules/ModuleLibraryCommand.ts archive",
        "modules:audit": "ts-node --project scripts/tsconfig.json scripts/modules/ModuleLibraryCommand.ts audit",
        "modules:doctor": "ts-node --project scripts/tsconfig.json scripts/modules/ModuleLibraryCommand.ts doctor",
        "modules:list": "ts-node --transpile-only --project scripts/generator/tsconfig.record-refresh.json scripts/modules/ListModules.ts",
        "operations": "ts-node --project tools/operations/tsconfig.json --files tools/operations/main.ts",
        "pm2启动service,http服务": "pm2 start deploy/pm2/development.config.cjs",
        "service.js测试": "node dist/app/index.js -p bearjoy -v dev --sid 1",
        "smoke:multiprocess": "node scripts/smoke/multiprocess.cjs",
        "test": "node test/run-tests.js",
        "test:bean-compile": "pnpm test:suite -- bean-compile",
        "test:build-artifacts": "node scripts/structure-baseline/verify-build-artifacts.js all",
        "test:compatibility": "node test/structure-baseline/compatibility-baseline.test.js",
        "test:compatibility:hashes": "node test/structure-baseline/compatibility-baseline.test.js --hashes",
        "test:error-codes": "pnpm test:suite -- errorcode",
        "test:file": "node test/run-tests.js --file",
        "test:module": "node test/run-tests.js --module",
        "test:suite": "node test/run-tests.js --suite",
        "typecheck": "pnpm gen:modules:check && pnpm 检查Bean编译记录 && tspc --noEmit --incremental false",
        "typeorm": "typeorm-ts-node-commonjs",
        "update:compatibility-baseline": "node scripts/structure-baseline/capture-compatibility-baseline.js --update",
        "verify": "pnpm check:generated && pnpm check:static && pnpm test -- --skip-bean-validation && pnpm build",
        "verify:kit-clean-host": "node scripts/kit/verify-clean-host.cjs",
        "verify:module": "ts-node --project scripts/tsconfig.json scripts/modules/VerifyModule.ts",
        "verify:native-lobby-live": "node scripts/verify/native-lobby-live.cjs",
        "verify:queued-action-recovery": "node scripts/verify/queued-local-action-recovery.cjs",
        "verify:quick": "pnpm check:quick",
        "一键生成代码": "pnpm generate",
        "启动http": "pnpm dev:http",
        "启动http-js": "node scripts/bean-compile/wireCompiledRuntime.js build/compiled && node build/compiled/alloy-server/src/http/main.js -p bearjoy -v dev -ap 25001",
        "启动service": "pnpm dev",
        "启动service-js": "node scripts/bean-compile/wireCompiledRuntime.js build/compiled && node build/compiled/alloy-server/src/main.js -p bearjoy -v dev --sid 1",
        "检查Bean编译记录": "ts-node --files scripts/bean-compile/validate-program.ts",
        "监听ts文件自动编译": "pnpm 检查Bean编译记录 && node scripts/bean-compile/watch-compiled-beans.js",
        "编译js": "pnpm gen:modules:check && pnpm 检查Bean编译记录 && tspc --incremental false && node scripts/bean-compile/normalizeCompiledSourceMaps.js build/compiled && node scripts/bean-compile/stripCompiledSourceMaps.js build/compiled && node scripts/bean-compile/wireCompiledRuntime.js build/compiled",
        "编译operations": "tspc --project tools/operations/tsconfig.json --incremental false && node scripts/bean-compile/normalizeCompiledSourceMaps.js build/compiled && node scripts/bean-compile/stripCompiledSourceMaps.js build/compiled",
        "静态检查": "pnpm typecheck"
    },
    "dependencies": {
        "@arthropoda/typeorm": "0.3.22",
        "async-mutex": "^0.4.1",
        "axios": "^1.6.8",
        "class-validator": "^0.14.1",
        "class-validator-jsonschema": "^5.0.1",
        "commander": "11.1.0",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "cron": "^3.1.6",
        "express": "^4.18.3",
        "help": "^3.0.2",
        "http-errors": "^2.0.0",
        "inversify": "^6.0.3",
        "inversify-express-utils": "^6.4.7",
        "jade": "^1.11.0",
        "joi": "^17.12.2",
        "json5": "^2.2.3",
        "koa": "^2.15.0",
        "lockfile": "^1.0.4",
        "logform": "^2.6.0",
        "moment": "^2.30.1",
        "morgan": "^1.10.0",
        "multer": "1.4.5-lts.1",
        "mysql": "^2.18.1",
        "mysql2": "3.22.6",
        "redis": "^4.6.13",
        "reflect-metadata": "^0.1.14",
        "routing-controllers": "^0.10.4",
        "routing-controllers-openapi": "^4.0.0",
        "swagger-ui-express": "^5.0.1",
        "tsconfig-paths": "^4.2.0",
        "typedi": "^0.10.0",
        "uuid": "^9.0.1",
        "winston": "^3.12.0",
        "winston-transport": "^4.7.0",
        "ws": "^8.16.0"
    },
    "devDependencies": {
        "@arthropoda/mysql-tool": "^0.0.70",
        "@redis/client": "^1.5.14",
        "@types/cookie-parser": "^1.4.7",
        "@types/ejs": "^3.1.5",
        "@types/express": "^4.17.21",
        "@types/express-serve-static-core": "^4.17.43",
        "@types/http-errors": "^2.0.4",
        "@types/lockfile": "^1.0.4",
        "@types/mocha": "^9.1.1",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.27",
        "@types/swagger-ui-express": "^4.1.7",
        "@types/uuid": "^9.0.8",
        "@types/ws": "^8.5.10",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@vercel/ncc": "^0.38.1",
        "@zurmokeeper/exceljs": "^4.4.7",
        "chai": "^4.4.1",
        "ejs": "^3.1.10",
        "ejs-lint": "^2.0.0",
        "eslint": "^8.57.0",
        "eslint-config-airbnb-typescript": "^17.1.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "exceljs": "^4.4.0",
        "mocha": "^9.2.2",
        "prettier": "^3.2.5",
        "prettier-plugin-packagejson": "^2.4.12",
        "ts-morph": "^19.0.0",
        "ts-node": "10.7.0",
        "ts-patch": "3.3.0",
        "tsbuffer": "^2.2.8",
        "typescript": "5.9.3"
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=20 <23"
    }
}

{
  "name": "@game/server",
  "version": "0.1.0",
  "private": true,
  "description": "Colyseus 0.17 游戏服务端",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "npm run stack && npm run db:bootstrap && npm run smoke:framework && tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx test/smoke.ts",
    "smoke:framework": "tsx tools/smoke.ts",
    "test": "node --import tsx --test --test-concurrency=4 test/*.test.ts",
    "test:int": "node --import tsx --test --test-concurrency=1 test/int/*.test.ts",
    "test:rooms": "node --import tsx --test --test-concurrency=2 test/game-room*.test.ts test/game-mode.test.ts test/idle-game-mode.test.ts test/snake*.test.ts test/drop-in.test.ts test/private-room.test.ts test/lifecycle.test.ts",
    "test:websocket": "node --import tsx --test --test-concurrency=2 test/lobby*.test.ts test/*rpc*.test.ts test/dispatcher-idem.test.ts test/mail-list.test.ts test/redeem-claim.test.ts",
    "test:core": "node --import tsx --test --test-concurrency=2 test/*lock*.test.ts test/*redis*.test.ts test/*idem*.test.ts test/*outbox*.test.ts test/loop-monitor.test.ts test/shutdown-aggregator.test.ts test/compute-pool.test.ts",
    "test:codegen": "node --import tsx --test --test-concurrency=1 test/plugin-codegen.test.ts test/gameplay-codegen.test.ts test/http-endpoint-manifest.test.ts",
    "check:generated": "npm run codegen:http -- --check && npm run codegen:gameplays -- --check && npm run codegen:plugins -- --check",
    "stack": "tools/dev-stack.sh start",
    "stack:stop": "tools/dev-stack.sh stop",
    "db:bootstrap": "tsx tools/db-bootstrap.ts",
    "relayer": "tsx src/core/economy/relayer.ts",
    "freeze-worker": "tsx src/core/archive/freezeWorker.ts",
    "settle": "tsx src/core/match/matchConsumer.ts",
    "codegen:http": "tsx tools/http-endpoint-manifest.ts",
    "codegen:gameplays": "node --import tsx tools/gameplay-codegen/cli.ts",
    "codegen:plugins": "node --import tsx tools/plugin-codegen/cli.ts",
    "plugin": "node --import tsx tools/plugin/cli.ts",
    "typecheck": "tsc --noEmit",
    "loadtest": "tsx loadtest/bot.ts --endpoint ws://localhost:2568 --room game --numClients 20",
    "dev:server-only": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.0",
    "@colyseus/schema": "^4.0.27",
    "@colyseus/tools": "^0.17.19",
    "@colyseus/ws-transport": "^0.17.0",
    "@game/shared": "0.1.0",
    "@gono/webplatform-contract": "file:../../vendor/gono-webplatform-contract-1.0.0.tgz",
    "colyseus": "^0.17.10",
    "express": "^5.1.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.22.6",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@colyseus/redis-driver": "^0.17.7",
    "@colyseus/redis-presence": "^0.17.7",
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/testing": "^0.17.0",
    "@types/express": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@types/node": "^22.13.14",
    "@colyseus/loadtest": "^0.17.0"
  },
  "engines": {
    "node": ">=22"
  }
}

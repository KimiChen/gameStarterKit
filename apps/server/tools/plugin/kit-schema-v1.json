{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kit.json v1（docs/KIT.md §3：一个 kit 一个文件——身份 + api 面 + 玩法清单 + SQL 账本声明 + 冷档键清单 + 客户端登记；登记面字段与 plugin.json v2 同名同义但命名空间是 kits/；宿主自有 kit 无 version；⛔ 不依赖别的 kit）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "description": { "type": "string", "pattern": "^.{0,200}$" },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][A-Za-z0-9]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "minSupported"],
          "properties": {
            "version": { "type": "integer", "minimum": 1 },
            "minSupported": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "constantName"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          "constantName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$" }
        }
      }
    },
    "sql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "tables"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string", "pattern": "^sql/[0-9]{3}-[a-z][a-z0-9-]{0,63}\\.sql$" }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "zone"],
            "properties": {
              "name": { "type": "string", "pattern": "^k_[a-z][a-z0-9]{0,63}_[a-z][a-z0-9_]{0,63}$" },
              "zone": { "type": "string", "pattern": "^(per-zone|global)$" }
            }
          }
        }
      }
    },
    "userKeys": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][A-Za-z0-9]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["userKey", "field", "max"],
          "properties": {
            "userKey": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
            "field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,63}$" },
            "max": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      }
    },
    "fguiPackages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$" }
    },
    "category": { "type": "string", "pattern": "^(core|extra)$" },
    "docs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*\\.md$" }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "defaultEntry", "sourceOfTruth", "wireBoundary", "verification", "docs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "category": { "type": "string", "pattern": "^(core|extra)$" },
          "defaultEntry": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*$" },
          "sourceOfTruth": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*$" },
          "wireBoundary": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*$" },
          "verification": { "type": "array", "items": { "type": "object" } },
          "docs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_/.-]*\\.md$" } },
          "launch": { "type": "object" }
        }
      }
    },
    "resident": { "type": "boolean" },
    "entry": { "type": "string", "pattern": "^apps/client/src/kits/[a-z][A-Za-z0-9]{0,63}/index\\.ts$" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
    },
    "viewDirs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^apps/client/src/[A-Za-z0-9_/.-]+$" }
    },
    "views": {
      "type": "array",
      "items": { "type": "string", "pattern": "^apps/client/src/[A-Za-z0-9_/.-]+View\\.view\\.json$" }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "logicDir"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          "logicDir": { "type": "string", "pattern": "^apps/client/src/(logic|kits)/[A-Za-z0-9_/.-]+$" }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "view"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          "view": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$" }
        }
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "label", "labelKey", "launch"],
        "properties": {
          "entryId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          "label": { "type": "string", "pattern": "^.{1,64}$" },
          "labelKey": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.]{0,127}$" },
          "icon": { "type": "string", "pattern": "^ui://[A-Za-z0-9_]+/[A-Za-z0-9_.-]+$" },
          "launch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "pattern": "^(gameplay|route)$" },
              "gameplayId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
              "routeId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
            }
          }
        }
      }
    }
  }
}

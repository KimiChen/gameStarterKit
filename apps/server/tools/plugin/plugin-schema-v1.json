{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plugin.json v1（docs/PLUGIN.md §5：插件只声明身份、版本、kinds 与兼容轴，⛔ 不放路径映射、不放位置）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "kinds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "kinds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(gameplay|feature)$" }
    },
    "constantName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$" },
    "domains": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
    },
    "fguiPackages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$" }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "featureSchemaVersion": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "gameplaySchemaVersion": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "description": { "type": "string", "pattern": "^.{0,200}$" }
  }
}

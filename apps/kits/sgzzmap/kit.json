{
  "schemaVersion": 1,
  "id": "sgzzmap",
  "description": "三战式大世界地基：1500×1500 odd-q 六边形稀疏地块、邻接占领、转折点行军、两档 AOI 与最小同盟",
  "api": {
    "hexmap": {
      "version": 1,
      "minSupported": 1
    },
    "territory": {
      "version": 1,
      "minSupported": 1
    },
    "alliance": {
      "version": 1,
      "minSupported": 1
    },
    "march": {
      "version": 1,
      "minSupported": 1
    },
    "chunk": {
      "version": 1,
      "minSupported": 1
    }
  },
  "domains": [
    "sgzzmap"
  ],
  "sql": {
    "files": [
      "sql/001-grid.sql",
      "sql/002-alliance.sql",
      "sql/003-march.sql",
      "sql/004-chunk.sql"
    ],
    "tables": [
      {
        "name": "k_sgzzmap_revision",
        "zone": "per-zone"
      },
      {
        "name": "k_sgzzmap_tile",
        "zone": "per-zone"
      },
      {
        "name": "k_sgzzmap_holding",
        "zone": "per-zone"
      },
      {
        "name": "k_sgzzmap_receipt",
        "zone": "per-zone"
      },
      {
        "name": "k_sgzzmap_log",
        "zone": "per-zone"
      },
      {
        "name": "k_sgzzmap_alliance",
        "zone": "per-zone"
      },
      {
        "name": "k_sgzzmap_alliance_member",
        "zone": "per-zone"
      },
      {
        "name": "k_sgzzmap_march",
        "zone": "per-zone"
      },
      {
        "name": "k_sgzzmap_chunk",
        "zone": "per-zone"
      }
    ]
  },
  "workers": [
    {
      "id": "marchSettle",
      "entry": "apps/server/src/kits/sgzzmap/workers/marchSettle.ts"
    }
  ],
  "category": "extra",
  "docs": [
    "apps/kits/sgzzmap/README.md"
  ],
  "resident": false
}

apps/client/src/ui-uniflex/generated/
apps/Cocos/assets/src/ui-uniflex/generated/
apps/Cocos/assets/src/ui-uniflex/generated.meta
apps/Cocos/assets/resources/uniflex/
apps/Cocos/assets/resources/uniflex.meta
# Cocos CLI 本地配置，指向 temp schema，不是作者态。
apps/Cocos/settings/cocos.config.json
*.log

# 构建产物
dist/

# SLG 地图管线中间产物（渲染大图/校准叠图；入库产物在 apps/kits/slg/{data,art}）
tools/slg-maps/out/
__pycache__/

# 本地预览验收截图与报告
/docs/evidence/

# ImageGen 概念图输出；设计说明与提示词另存 docs/concepts/
output/imagegen/

# 环境配置
.env
!.env.development

# IDE / 编辑器
.idea/
.vscode/
.settings/
.project
.classpath
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini

# Cocos Creator（apps/Cocos）——编辑器可再生目录
apps/Cocos/library/
apps/Cocos/temp/
apps/Cocos/local/
apps/Cocos/build/
apps/Cocos/profiles/
apps/Cocos/native/

# apps/client 是纯 TS 工程、不是 Creator 工程；以下四项是被 Creator 误打开后留下的
# 可再生缓存/扩展副本（extensions 只归 apps/Cocos），勿提交
apps/client/library/
apps/client/temp/
apps/client/profiles/
apps/client/extensions/

# 说明站已迁移到独立仓库；本地 Sites checkout 可以留在原路径，但不属于本 monorepo
apps/website/

# FairyGUI 编辑器工程缓存(.objs：metas + workspace.json，编辑器可再生，勿提交)；
# .fairy/assets/settings 是源须提交，仅 .objs 忽略。无路径前缀=匹配任意 FairyGUI 工程。
.objs/

# 说明：
#  - apps/Cocos/assets/src/ 是 sync:client 从 apps/client/src 同步的生成物，但需要提交
#    （连同 .meta，保证 uuid 稳定、新 checkout 可直接打开工程）
#  - apps/Cocos/settings/ 需要提交（工程配置）
#  - 运行时产物（colyseus.js×2、fairygui-cc/runtime/）**入库**：版本钉死、新机 clone 即可用；
#    仅框架维护团队显式升级时运行 `npm run fetch:colyseus` / `fetch:fgui`（拉新版 + 验完整性）后提交 diff
